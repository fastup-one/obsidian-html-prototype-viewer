{
	"name": "html-prototype-viewer-strict",
	"version": "1.0.1-strict.3",
	"description": "Hardened fork of HTML Prototype Viewer: HTML files open isolated and without network by default.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "tsc -noEmit -skipLibCheck && node esbuild.test.mjs && node --test test-dist/*.test.mjs",
		"check": "npm test && npm run build && node scripts/check-bundle.mjs",
		"package": "node scripts/package.mjs",
		"install-local": "node scripts/install-local.mjs"
	},
	"devDependencies": {
		"@types/node": "22.20.1",
		"esbuild": "0.25.12",
		"obsidian": "1.13.1",
		"typescript": "5.9.3"
	}
}
